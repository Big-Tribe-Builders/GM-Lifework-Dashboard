# Supabase — leave blank to run the dashboard on bundled seed data.
# Fill these in to switch the whole app onto your live Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for migrations/seeding scripts, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Client data -------------------------------------------------------------
# Read live from Notion, rendered, and stored nowhere. All three are
# SERVER-SIDE: a NEXT_PUBLIC_ token would ship a key to the browser that can
# read every client. Leave blank and the Clients zone says it is not connected.
NOTION_TOKEN=
NOTION_CLIENTS_DB=
NOTION_CLIENT_TASKS_DB=

# Sign-in. "on" makes every page need an account (set up your own first, in
# Settings > Users or the Supabase dashboard). Anything else leaves it open.
LIFEWORK_AUTH=

# --- Mailing ----------------------------------------------------------------
# Server-only. The Resend API key (resend.com → API Keys). Without it the
# Mailing space works but nothing is sent, and it says so.
RESEND_API_KEY=
# The signing secret of the Resend webhook pointed at /api/mail/webhook.
RESEND_WEBHOOK_SECRET=
# Vercel sends this as a bearer token to /api/mail/tick (the daily cron).
CRON_SECRET=

# --- QuinB Community ----------------------------------------------------------
# Server-only. The Mighty Networks Admin API (Settings → API Keys in the QuinB
# network; the plan must include the API). Without both, the Comments and New
# members tabs say what is missing and nothing is called.
MIGHTY_API_KEY=
# The number of the QuinB network, shown on the same API Keys page.
MIGHTY_NETWORK_ID=
